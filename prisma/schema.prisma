generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Singleton row (id is always 1) holding contact/social details shared
// across the header, footer and location section.
model SiteSettings {
  id              Int      @id @default(1)
  phone           String
  phoneHref       String
  email           String
  lbNagarAddress  String
  kingKotiAddress String
  instagramUrl    String   @default("")
  facebookUrl     String   @default("")
  linkedinUrl     String   @default("")
  youtubeUrl      String   @default("")
  updatedAt       DateTime @updatedAt
}

// Singleton row (id is always 1) holding the hero section's editorial copy.
model HeroContent {
  id               Int      @id @default(1)
  badgePrefix      String
  headingPlain     String
  headingHighlight String
  subheading       String
  description      String
  updatedAt        DateTime @updatedAt
}

// SEO settings for fixed public pages that do not have their own content row.
model PageSeo {
  slug            String   @id
  label           String
  metaTitle       String   @default("")
  metaDescription String   @default("")
  updatedAt       DateTime @updatedAt
}

// Shared counters reused across sections (hero badge, About, Why Us, Awards)
// so a single edit updates every place a number appears.
model Stat {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  value     String
  label     String
  updatedAt DateTime @updatedAt
}

// Top navigation / FAQ category taxonomy.
model CareCategory {
  id       Int       @id @default(autoincrement())
  key      String    @unique
  label    String
  order    Int       @default(0)
  faqItems FaqItem[]
}

// Copy for the four care-category landing pages (/womens-care, /child-care,
// /pregnancy-birth-support, /fertility-care). One fixed row per page, keyed
// by the page's own slug — independent of ServiceCategory/CareCategory keys,
// since those don't map 1:1 onto these four routes (e.g. pregnancy-birth-
// support reuses the "Women Care" ServiceCategory's services).
model CareCategoryContent {
  id    Int    @id @default(autoincrement())
  slug  String @unique
  label String

  heroBadge             String @default("")
  heroHeadingLine1      String @default("")
  heroHeadingHighlight1 String @default("")
  heroHeadingHighlight2 String @default("")
  heroHeadingLine2      String @default("")
  heroDescription       String @default("")
  heroImage             String @default("")

  journeyHeading   String @default("")
  journeyHighlight String @default("")
  // JourneyItem[] = {image, question, cta}[] — always 4 cards.
  journey          Json   @default("[]")

  talkToExpertsHeading String @default("")
  talkToExpertsBody    String @default("")

  whyChooseHeading    String @default("")
  whyChooseHighlight  String @default("")
  whyChooseBody       String @default("")

  excellenceEyebrow   String @default("")
  excellenceHeading   String @default("")
  excellenceHighlight String @default("")
  excellenceBody      String @default("")

  // SEO overrides — blank falls back to label/heroDescription.
  metaTitle       String @default("")
  metaDescription String @default("")
}

model ServiceCategory {
  id    Int           @id @default(autoincrement())
  key   String        @unique
  label String
  order Int           @default(0)
  items ServiceItem[]
}

model ServiceItem {
  id          Int             @id @default(autoincrement())
  categoryId  Int
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug        String          @unique
  name        String
  description String
  order       Int             @default(0)

  // Detail page fields (/services/[slug]) — optional so existing services
  // keep working without them.
  detail    String @default("")
  heroImage String @default("")
  // Ordered page sections authored from the admin. Uses the same flexible
  // section / callout / takeaway structure as blog articles.
  blocks    Json   @default("[]")

  // SEO overrides — blank falls back to name/description.
  metaTitle       String @default("")
  metaDescription String @default("")
}

model FaqItem {
  id          Int          @id @default(autoincrement())
  categoryKey String
  category    CareCategory @relation(fields: [categoryKey], references: [key], onDelete: Cascade)
  question    String
  answer      String
  order       Int          @default(0)
}

model Doctor {
  id              Int     @id @default(autoincrement())
  slug            String  @unique
  name            String
  qualifications  String
  role            String
  image           String
  yearsExperience String
  languages       String
  location        String
  isFeatured      Boolean @default(false)
  order           Int     @default(0)

  // Profile page fields (/doctors/[slug]) — optional so existing doctors
  // keep working without them; the profile page falls back to site-wide
  // contact details (SiteSettings) when these are blank.
  designation String @default("")
  bio         String @default("")
  timing      String @default("")
  phone       String @default("")
  email       String @default("")
  fullAddress String @default("")

  // SEO overrides for /doctors/[slug].
  metaTitle       String @default("")
  metaDescription String @default("")
}

// "Doctors Talk" video/tip cards shown on the Doctors listing page.
model DoctorTip {
  id         Int    @id @default(autoincrement())
  title      String
  doctorName String
  image      String
  videoUrl   String @default("")
  order      Int    @default(0)
}

model Testimonial {
  id    Int    @id @default(autoincrement())
  name  String
  quote String
  order Int    @default(0)

  // Optional patient photo and video testimonial — blank photo falls back to
  // an initials avatar; blank video just omits the play button.
  image    String @default("")
  videoUrl String @default("")
}

model Blog {
  id    Int    @id @default(autoincrement())
  slug  String @unique
  title String
  date  String
  image String
  order Int    @default(0)

  // Article page fields (/blog/[slug]) — category is the discriminator for
  // "has a full article" (used by both the homepage teaser cards and the
  // /blog listing + detail pages). blocks holds the rich body content as an
  // ordered array of {kind:"section"|"alert"|"takeaway", ...} objects,
  // authored through the admin's block editor.
  category String @default("")
  summary  String @default("")
  intro    String @default("")
  blocks   Json   @default("[]")

  // SEO overrides — blank falls back to title/summary.
  metaTitle       String @default("")
  metaDescription String @default("")
}

// Submissions from the hero quick-booking widget and the main appointment
// form, across every page. Always saved here; optionally also forwarded to
// LEAD_WEBHOOK_URL when that's configured.
model AppointmentRequest {
  id              Int      @id @default(autoincrement())
  name            String
  email           String
  phone           String
  preferredDate   String
  service         String
  location        String
  doctor          String?
  appointmentType String?
  source          String?
  status          String   @default("new")
  createdAt       DateTime @default(now())
}

// A physical clinic/hospital location, each with its own public page at
// /locations/[slug]. Add a row here (plus its highlights) to publish a new
// location page without any code changes.
model Location {
  id                Int                 @id @default(autoincrement())
  slug              String              @unique
  name              String
  address           String
  phone             String
  phoneHref         String
  email             String
  mapUrl            String
  heroImage         String
  servicesImage     String              @default("")
  clinicImage       String              @default("")
  introParagraph    String              @default("")
  whatToExpectIntro String              @default("")
  carePromiseIntro  String              @default("")
  whyChooseIntro    String              @default("")
  reachIntro        String              @default("")
  // Fully custom ordered sections for this location slug. When present,
  // these replace the legacy fixed middle-section layout.
  blocks            Json                @default("[]")
  order             Int                 @default(0)
  highlights        LocationHighlight[]

  // SEO overrides — blank falls back to name/address.
  metaTitle       String @default("")
  metaDescription String @default("")
}

// Repeating cards on a location page — what section they belong to is
// stored in `section` (service | step | promise | feature | stat | reach)
// so every list on the page is editable from the admin without new models.
model LocationHighlight {
  id          Int      @id @default(autoincrement())
  locationId  Int
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  section     String
  title       String
  description String   @default("")
  order       Int      @default(0)
}

// Emails collected from the footer "Ready to Talk" newsletter form, shared
// across every page.
model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
}
