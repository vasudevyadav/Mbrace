# Appointment requests and newsletter subscriptions are always saved to the
# database and visible under Admin > Appointment Leads / Subscribers.
# Optionally also forward appointment requests to a CRM webhook (e.g. GoHighLevel).
# This is server-side only now — no NEXT_PUBLIC_ prefix needed.
LEAD_WEBHOOK_URL=
# Canonical production origin, used for social previews, sitemap and robots.
NEXT_PUBLIC_SITE_URL=

# Database used by the admin panel and homepage content. SQLite locally;
# swap to a Postgres connection string (e.g. Neon) in production — no schema changes needed.
DATABASE_URL="file:./dev.db"
# Single-admin login for /admin. Change this before deploying.
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie. Change this before deploying.
ADMIN_SESSION_SECRET=
